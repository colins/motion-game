[Unit]
Description=Godot Floor Game Kiosk
After=network.target lidar-bridge.service
Wants=lidar-bridge.service

[Service]
Type=simple
User=colin
WorkingDirectory=/home/colin
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WLR_LIBINPUT_NO_DEVICES=1
ExecStart=/home/colin/start_game.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
